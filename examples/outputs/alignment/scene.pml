# MolScene standalone replay: use @scene.pml in PyMOL.
# For directories containing parser punctuation, use this Python loader:
# import os
# old = os.getcwd()
# os.chdir(output_directory)
# try: cmd.do("@scene.pml")
# finally: os.chdir(old)
# The loader uses only os and the active PyMOL cmd (no MolScene install).
python
from pathlib import Path
_molscene_root = Path(__script__).resolve().parent
cmd.load(str(_molscene_root / 'inputs/mobile.pdb'), 'mobile')
cmd.load(str(_molscene_root / 'inputs/target.cif'), 'target')
cmd.bg_color('white')
cmd.set('ray_opaque_background', 1)
cmd.set('antialias', 2)
cmd.set('orthoscopic', 1)
cmd.set('depth_cue', 0)
cmd.set('ray_shadows', 0)
cmd.set('specular', 0.2)
cmd.set('cartoon_trace_atoms', 0)
cmd.hide('everything', 'all')
cmd.frame(1)
cmd.set('cartoon_trace_atoms', 0, 'mobile')
cmd.set('cartoon_trace_atoms', 0, 'target')
cmd.select('_molscene_mobile', '(mobile) and (polymer.protein and name CA)', state=1, enable=0, quiet=1)
cmd.select('_molscene_target', '(target) and (polymer.protein and name CA)', state=1, enable=0, quiet=1)
cmd.align('_molscene_mobile', '_molscene_target', cutoff=2.0, cycles=5, gap=-10.0, extend=-0.5, max_gap=50, object='alignment', transform=1, mobile_state=1, target_state=1)
cmd.select('_molscene_mobile_display', 'mobile', state=1, enable=0, quiet=1)
cmd.set('state', 1, 'mobile')
cmd.count_atoms('_molscene_mobile_display')
cmd.count_atoms('((_molscene_mobile_display) and polymer) and guide')
cmd.get_object_list('(_molscene_mobile_display) and polymer')
cmd.count_atoms('(mobile) and polymer.protein')
cmd.count_atoms('((mobile) and polymer.protein) and not name CA')
cmd.set('cartoon_trace_atoms', 0, 'mobile')
cmd.set('ribbon_trace_atoms', 0, 'mobile')
cmd.show('cartoon', '(_molscene_mobile_display) and polymer')
cmd.count_atoms('(_molscene_mobile_display) and polymer')
cmd.color('marine', '_molscene_mobile_display')
cmd.select('_molscene_target_display', 'target', state=1, enable=0, quiet=1)
cmd.set('state', 1, 'target')
cmd.count_atoms('_molscene_target_display')
cmd.count_atoms('((_molscene_target_display) and polymer) and guide')
cmd.get_object_list('(_molscene_target_display) and polymer')
cmd.count_atoms('(target) and polymer.protein')
cmd.count_atoms('((target) and polymer.protein) and not name CA')
cmd.set('cartoon_trace_atoms', 0, 'target')
cmd.set('ribbon_trace_atoms', 0, 'target')
cmd.show('cartoon', '(_molscene_target_display) and polymer')
cmd.count_atoms('(_molscene_target_display) and polymer')
cmd.color('orange', '_molscene_target_display')
cmd.orient('_molscene_mobile_display or _molscene_target_display')
cmd.zoom('_molscene_mobile_display or _molscene_target_display', 3)
cmd.deselect()
cmd.viewport(1000, 750)
python end
